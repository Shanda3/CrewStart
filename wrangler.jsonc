{
  // Crewstart: static assets + a small Worker for the optional email opt-in.
  // Local:  npx wrangler dev        Deploy ONLY after Shanda approves: see DEPLOY.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crewstart",
  // account_id is intentionally not committed (public repo). Wrangler reads CLOUDFLARE_ACCOUNT_ID from the
  // environment or from a local, gitignored .env file; see DEPLOY.md.
  // Fail-safe: no workers.dev URL or preview URLs until Shanda approves going live (see DEPLOY.md).
  "workers_dev": false,
  "preview_urls": false,
  // Live on crewstart.ai (Shanda approved going public, November 20, 2026).
  "routes": [
    { "pattern": "crewstart.ai", "custom_domain": true },
    { "pattern": "www.crewstart.ai", "custom_domain": true }
  ],
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /privacy.html is served at /privacy (not the SPA index).
    "html_handling": "auto-trailing-slash",
    // The Worker runs only for these paths; everything else is served as static files.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crewstart-db",
      // Created November 20, 2026; migrations are applied with `wrangler d1 migrations apply --remote`.
      "database_id": "ecf9ebdb-ec93-4993-af78-078a571bcdfe",
      "migrations_dir": "migrations"
    }
  ],
  // Shanda: no access logs. Workers Logs (request/invocation logs) stay off.
  "observability": { "enabled": false }
}
