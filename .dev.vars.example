# Copy to .dev.vars for local dev (never commit .dev.vars).
# Use Cloudflare's documented Turnstile TEST secret for local dev:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/  (the "always passes" secret key)
TURNSTILE_SECRET_KEY=<turnstile-test-secret-always-passes>
# RATE_LIMIT_SALT=<any random string; optional locally>
